# Supabase Configuration for Shohoj Khamar (সহজ খামার)
# Obtain these from your Supabase Dashboard: Project Settings > API

# 1. Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anon / Public Key (Safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public origin used for canonical URLs, sitemap.xml, and robots.txt.
# Set this to your real production domain in Vercel before deploying.
# If omitted on Vercel, the production project domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

